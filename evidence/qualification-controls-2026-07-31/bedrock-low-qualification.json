              "role": "assistant",
              "content": "function selectCampaigns(campaigns, maxSpend) {\n  // Clone to avoid mutating original array\n  const items = campaigns.map(c => ({\n    id: c.id,\n    spend: c.dailySpend,\n    signups: c.expectedSignups\n  }));\n\n  const n = items.length;\n  let best = {\n    signups: -1,\n    spend: Infinity,\n    ids: []\n  };\n\n  // Helper to compare two candidates\n  const better = (a, b) => {\n    if (a.signups !== b.signups) return a.signups > b.signups;\n    if (a.spend !== b.spend) return a.spend < b.spend;\n    const aKey = a.ids.join(',');\n    const bKey = b.ids.join(',');\n    return aKey < bKey;\n  };\n\n  // Enumerate all subsets (suitable for modest n)\n  const totalSubsets = 1 << n;\n  for (let mask = 0; mask < totalSubsets; mask++) {\n    let sumSpend = 0;\n    let sumSignups = 0;\n    const ids = [];\n\n    for (let i = 0; i < n; i++) {\n      if (mask & (1 << i)) {\n        const it = items[i];\n        sumSpend += it.spend;\n        if (sumSpend > maxSpend) break; // early exit\n        sumSignups += it.signups;\n        ids.push(it.id);\n      }\n    }\n\n    if (sumSpend > maxSpend) continue;\n\n    ids.sort(); // ensure lexicographic order for tie‑break\n    const candidate = { signups: sumSignups, spend: sumSpend, ids };\n    if (better(candidate, best)) best = candidate;\n  }\n\n  return best.ids;\n}",
