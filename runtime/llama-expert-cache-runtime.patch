+static enum ggml_status ggml_metal_expert_cache_compute_range(
+        ggml_metal_t ctx,
+        struct ggml_cgraph * gf,
+        int idx_start,
+        int idx_end) {
+    if (idx_start >= idx_end) {
+        return GGML_STATUS_SUCCESS;
+    }
+
+    id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+    id<MTLCommandBuffer> cmd_buf =
+        [[queue commandBufferWithUnretainedReferences] retain];
+
+    ggml_metal_op_t ctx_op = ggml_metal_op_init(
+        ctx->dev,
+        cmd_buf,
+        gf,
+        idx_start,
+        idx_end,
+        false,
+        false,
+        false,
+        ctx->debug_graph,
+        ctx->debug_fusion);
+
+    for (int idx = 0; idx < ggml_metal_op_n_nodes(ctx_op); ++idx) {
+        const int res = ggml_metal_op_encode(ctx_op, idx);
+        if (res == 0) {
+            break;
+        }
+        idx += res - 1;
+    }
+
+    ggml_metal_op_free(ctx_op);
+    [cmd_buf commit];
+    [cmd_buf waitUntilCompleted];
+
+    const MTLCommandBufferStatus status = [cmd_buf status];
+    if (status != MTLCommandBufferStatusCompleted) {
+        GGML_LOG_ERROR(
+            "%s: ExpertCache command buffer [%d,%d) failed with status %d\n",
+            __func__,
+            idx_start,
+            idx_end,
+            (int) status);
+        if (status == MTLCommandBufferStatusError) {
+            GGML_LOG_ERROR(
+                "error: %s\n",
+                [[cmd_buf error].localizedDescription UTF8String]);
+        }
+        [cmd_buf release];
+        ctx->has_error = true;
+        return GGML_STATUS_FAILED;
+    }
+
+    [cmd_buf release];
+    return GGML_STATUS_SUCCESS;
+}
+
 enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph * gf) {
     if (ctx->has_error) {
         GGML_LOG_ERROR("%s: backend is in error state from a previous command buffer failure - recreate the backend to recover\n", __func__);
         return GGML_STATUS_FAILED;
     }
 
+    const char * expert_cache_env = getenv("GGML_METAL_EXPERT_CACHE_SLOTS");
+    if (expert_cache_env != NULL && atoi(expert_cache_env) > 0) {
+        const bool cpu_fill =
+            getenv("GGML_METAL_EXPERT_CACHE_CPU_FILL") != NULL;
+
+        if (cpu_fill) {
+            // Architectural proof path: run ordinary graph spans normally,
+            // synchronizing only before each routed expert projection so the
+            // selected IDs are visible to the CPU. The CPU copies just those
+            // selected byte ranges from the mmap-backed GGUF tensor into the
+            // shared Metal slots. Crucially, the full expert projection is
+            // never bound to a Metal command encoder in this mode.
+            if (ctx->cmd_buf_last) {
+                [ctx->cmd_buf_last waitUntilCompleted];
+                ctx->cmd_buf_last = nil;
+            }
+
+            const bool trace =
+                getenv("GGML_METAL_EXPERT_CACHE_TRACE") != NULL;
+            const CFAbsoluteTime graph_started =
+                trace ? CFAbsoluteTimeGetCurrent() : 0;
+            double ordinary_ms = 0;
+            double staging_ms = 0;
+            double expert_ms = 0;
+            double tail_ms = 0;
+            int expert_groups = 0;
+            int expert_projections = 0;
+            int range_start = 0;
+            for (int node_index = 0; node_index < gf->n_nodes; ++node_index) {
+                struct ggml_tensor * node = gf->nodes[node_index];
+                if (!ggml_metal_op_mul_mat_id_is_expert_cache_candidate(node)) {
+                    continue;
+                }
+
+                @autoreleasepool {
+                    const CFAbsoluteTime ordinary_started =
+                        trace ? CFAbsoluteTimeGetCurrent() : 0;
+                    enum ggml_status status =
+                        ggml_metal_expert_cache_compute_range(
+                            ctx, gf, range_start, node_index);
+                    if (trace) {
+                        ordinary_ms += (
+                            CFAbsoluteTimeGetCurrent() - ordinary_started
+                        ) * 1000.0;
+                    }
+                    if (status != GGML_STATUS_SUCCESS) {
+                        return status;
+                    }
+                    if (!ggml_metal_op_mul_mat_id_uses_expert_cache(node)) {
+                        GGML_LOG_ERROR(
+                            "%s: routed union for node %d '%s' exceeds the configured expert-cache slots\n",
+                            __func__,
+                            node_index,
+                            node->name);
+                        ctx->has_error = true;
+                        return GGML_STATUS_FAILED;
+                    }
+
+                    // All routed projections in one transformer layer share
+                    // the same selected-ID tensor. Give each projection its
+                    // own bounded slot buffer, stage them together after one
+                    // routing synchronization, then execute the complete
+                    // layer span in a single command buffer. This replaces
+                    // three CPU/GPU barriers per layer with one.
+                    const struct ggml_tensor * route_ids = node->src[2];
+                    int group_end = node_index;
+                    struct ggml_tensor * group_nodes[8] = { nil };
+                    int group_node_indices[8] = { 0 };
+                    int group_count = 0;
+                    for (int scan = node_index; scan < gf->n_nodes; ++scan) {
+                        struct ggml_tensor * candidate = gf->nodes[scan];
+                        if (!ggml_metal_op_mul_mat_id_is_expert_cache_candidate(candidate)) {
+                            continue;
+                        }
+                        if (candidate->src[2] != route_ids) {
+                            break;
+                        }
+                        if (!ggml_metal_op_mul_mat_id_uses_expert_cache(candidate)) {
+                            GGML_LOG_ERROR(
+                                "%s: routed union for node %d '%s' exceeds the configured expert-cache slots\n",
+                                __func__,
+                                scan,
+                                candidate->name);
+                            ctx->has_error = true;
+                            return GGML_STATUS_FAILED;
+                        }
+                        GGML_ASSERT(group_count < 8);
+                        group_nodes[group_count] = candidate;
+                        group_node_indices[group_count] = scan;
+                        group_count++;
+                        group_end = scan + 1;
+                    }
+
+                    const CFAbsoluteTime staging_started =
+                        trace ? CFAbsoluteTimeGetCurrent() : 0;
+                    bool stage_results[8] = { false };
+                    for (int group_index = 0;
+                         group_index < group_count;
+                         ++group_index) {
+                        stage_results[group_index] =
+                            ggml_metal_op_expert_cache_prepare_cpu(
+                                ctx->dev, group_nodes[group_index]);
+                    }
+
+                    for (int group_index = 0;
+                         group_index < group_count;
+                         ++group_index) {
+                        if (!stage_results[group_index]) {
+                            GGML_LOG_ERROR(
+                                "%s: ExpertCache CPU staging failed for node %d '%s'\n",
+                                __func__,
+                                group_node_indices[group_index],
+                                group_nodes[group_index]->name);
+                            ctx->has_error = true;
+                            return GGML_STATUS_FAILED;
+                        }
+                        expert_projections++;
+                    }
+                    if (trace) {
+                        staging_ms += (
+                            CFAbsoluteTimeGetCurrent() - staging_started
+                        ) * 1000.0;
+                    }
+
+                    const CFAbsoluteTime expert_started =
+                        trace ? CFAbsoluteTimeGetCurrent() : 0;
+                    status = ggml_metal_expert_cache_compute_range(
+                        ctx, gf, node_index, group_end);
+                    if (trace) {
+                        expert_ms += (
+                            CFAbsoluteTimeGetCurrent() - expert_started
+                        ) * 1000.0;
+                    }
+                    if (status != GGML_STATUS_SUCCESS) {
+                        return status;
+                    }
+
+                    expert_groups++;
+                    range_start = group_end;
+                    node_index = group_end - 1;
+                }
+            }
+
+            @autoreleasepool {
+                const CFAbsoluteTime tail_started =
+                    trace ? CFAbsoluteTimeGetCurrent() : 0;
+                enum ggml_status status =
+                    ggml_metal_expert_cache_compute_range(
+                        ctx, gf, range_start, gf->n_nodes);
+                if (trace) {
+                    tail_ms += (
+                        CFAbsoluteTimeGetCurrent() - tail_started
+                    ) * 1000.0;
+                }
+                if (status != GGML_STATUS_SUCCESS) {
+                    return status;
+                }
+            }
+
+            if (trace) {
+                const double total_ms =
+                    (CFAbsoluteTimeGetCurrent() - graph_started) * 1000.0;
+                GGML_LOG_INFO(
+                    "ExpertCache graph nodes=%d groups=%d projections=%d "
+                    "ordinary_ms=%.3f staging_ms=%.3f expert_ms=%.3f "
+                    "tail_ms=%.3f total_ms=%.3f\n",
+                    gf->n_nodes,
+                    expert_groups,
+                    expert_projections,
+                    ordinary_ms,
+                    staging_ms,
+                    expert_ms,
+                    tail_ms,
+                    total_ms);
+            }
+
+            return GGML_STATUS_SUCCESS;
+        }
+
+        // A normal inference graph references every MoE projection in one or
+        // two command buffers. Metal accounts those complete mapped resources
+        // even when the ExpertCache kernel reads only four routed slices. Keep
+        // each command buffer's resource set bounded while proving the cache
+        // architecture. This deliberately synchronous baseline will be
+        // replaced by event-chained streaming once first-token correctness is
+        // established.
+        const char * nodes_env = getenv("GGML_METAL_EXPERT_CACHE_NODES_PER_CB");
+        const int nodes_per_cb = nodes_env ? MAX(1, atoi(nodes_env)) : 32;
+        id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+
+        if (ctx->cmd_buf_last) {
+            [ctx->cmd_buf_last waitUntilCompleted];
+            ctx->cmd_buf_last = nil;
+        }
+
+        for (int idx_start = 0; idx_start < gf->n_nodes; idx_start += nodes_per_cb) {
+            const int idx_end = MIN(idx_start + nodes_per_cb, gf->n_nodes);
+            id<MTLCommandBuffer> cmd_buf =
+                [[queue commandBufferWithUnretainedReferences] retain];
+
+            ggml_metal_op_t ctx_op = ggml_metal_op_init(
+                ctx->dev,
+                cmd_buf,
+                gf,
+                idx_start,
+                idx_end,
+                ctx->use_fusion,
+                false,
+                false,
+                ctx->debug_graph,
+                ctx->debug_fusion);
+
+            for (int idx = 0; idx < ggml_metal_op_n_nodes(ctx_op); ++idx) {
+                const int res = ggml_metal_op_encode(ctx_op, idx);
+                if (res == 0) {
+                    break;
+                }
+                idx += res - 1;
+            }
+
+            ggml_metal_op_free(ctx_op);
+            [cmd_buf commit];
+            [cmd_buf waitUntilCompleted];
+
+            const MTLCommandBufferStatus status = [cmd_buf status];
+            if (status != MTLCommandBufferStatusCompleted) {
+                GGML_LOG_ERROR(
+                    "%s: ExpertCache command buffer [%d,%d) failed with status %d\n",
+                    __func__, idx_start, idx_end, (int) status);
+                for (int node_index = idx_start; node_index < idx_end; ++node_index) {
+                    const struct ggml_tensor * node = gf->nodes[node_index];
+                    const struct ggml_tensor * src0 = node->src[0];
+                    GGML_LOG_ERROR(
+                        "  node %d: op=%s name='%s' src0='%s' type=%s ne=[%lld,%lld,%lld,%lld]\n",
+                        node_index,
+                        ggml_op_name(node->op),
+                        node->name,
+                        src0 ? src0->name : "",
+                        src0 ? ggml_type_name(src0->type) : "none",
+                        src0 ? (long long) src0->ne[0] : 0,
+                        src0 ? (long long) src0->ne[1] : 0,
+                        src0 ? (long long) src0->ne[2] : 0,
+                        src0 ? (long long) src0->ne[3] : 0);
+                }
+                if (status == MTLCommandBufferStatusError) {
+                    GGML_LOG_ERROR("error: %s\n", [[cmd_buf error].localizedDescription UTF8String]);
+                }
+                [cmd_buf release];
+                ctx->has_error = true;
+                return GGML_STATUS_FAILED;
+            }
+
+            // Release every completed command buffer immediately. Holding the
+            // objects until an outer autorelease pool drains also holds their
+            // mapped expert resources, causing residency to accumulate one
+            // layer at a time despite the bounded slot cache.
+            [cmd_buf release];
+        }
+
+        return GGML_STATUS_SUCCESS;
+    }
+
     // number of nodes encoded by the main thread (empirically determined)
     const int n_main = MAX(64, 0.1*gf->n_nodes);
 
