+static ggml_metal_expert_cache & ggml_metal_get_expert_cache(
+        ggml_metal_device_t dev,
+        const ggml_tensor * tensor,
+        size_t weight_bytes,
+        size_t id_bytes) {
+    static std::mutex mutex;
+    static std::unordered_map<
+        ggml_metal_device_t,
+        std::unordered_map<const ggml_tensor *, ggml_metal_expert_cache>
