+    if (cache.id_capacity < id_bytes) {
+        if (cache.ids != nullptr) {
+            ggml_metal_buffer_free(cache.ids);
+        }
+        cache.ids = ggml_metal_buffer_init(dev, id_bytes, cpu_fill);
+        GGML_ASSERT(cache.ids != nullptr);
+        cache.id_capacity = id_bytes;
+    }
+
+    if (getenv("GGML_METAL_EXPERT_CACHE_GROUPED") != nullptr) {
+        const size_t route_map_bytes = 2 * sizeof(int32_t) * (id_bytes / sizeof(int32_t));
+        if (cache.route_map_capacity < route_map_bytes) {
+            if (cache.route_map != nullptr) {
+                ggml_metal_buffer_free(cache.route_map);
+            }
+            cache.route_map = ggml_metal_buffer_init(dev, route_map_bytes, cpu_fill);
+            GGML_ASSERT(cache.route_map != nullptr);
+            cache.route_map_capacity = route_map_bytes;
+        }
+    }
+
+    return cache;
+}
