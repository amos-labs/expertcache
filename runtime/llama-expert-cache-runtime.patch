+static int32_t ggml_metal_expert_cache_effective_id(
+        const ggml_tensor * selected_ids,
+        int64_t experts_used,
+        int64_t route,
+        int64_t n_experts) {
+    if (getenv("GGML_METAL_EXPERT_CACHE_HOT_CEILING") != nullptr) {
+        // Synthetic performance ceiling only: repeatedly bind the same four
+        // experts so their mapped pages can remain resident after warmup.
+        // This intentionally invalidates model quality and must never be
+        // enabled for normal inference.
+        return (int32_t) (route % std::min<int64_t>(4, n_experts));
+    }
+    GGML_ASSERT(selected_ids != nullptr);
+    GGML_ASSERT(selected_ids->data != nullptr);
+    GGML_ASSERT(experts_used > 0);
+    const int64_t expert_slot = route % experts_used;
+    const int64_t token = route / experts_used;
+    const uint8_t * selected_data =
+        static_cast<const uint8_t *>(selected_ids->data);
+    const int32_t * selected_id = reinterpret_cast<const int32_t *>(
+        selected_data +
+        (size_t) expert_slot * selected_ids->nb[0] +
+        (size_t) token * selected_ids->nb[1]);
+    return *selected_id;
+}
+
+static int64_t ggml_metal_expert_cache_unique_count(
+        const ggml_tensor * selected_ids,
+        int64_t experts_used,
+        int64_t n_tokens,
+        int64_t n_experts) {
+    if (selected_ids == nullptr ||
+        selected_ids->data == nullptr ||
+        experts_used <= 0 ||
+        n_tokens <= 0 ||
+        n_experts <= 0) {
+        return n_experts;
+    }
+    std::vector<uint8_t> seen(n_experts, 0);
+    int64_t unique = 0;
+    for (int64_t route = 0;
+         route < experts_used * n_tokens;
+         ++route) {
+        const int32_t expert_id = ggml_metal_expert_cache_effective_id(
+            selected_ids, experts_used, route, n_experts);
+        if (expert_id < 0 || expert_id >= n_experts) {
+            return n_experts;
+        }
+        if (!seen[expert_id]) {
+            seen[expert_id] = 1;
+            unique++;
+        }
+    }
+    return unique;
+}
