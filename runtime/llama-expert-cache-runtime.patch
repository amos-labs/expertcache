+    if (cache.weight_capacity < weight_bytes) {
+        if (cache.weights != nullptr) {
+            ggml_metal_buffer_free(cache.weights);
+        }
+        cache.weights = ggml_metal_buffer_init(dev, weight_bytes, cpu_fill);
+        GGML_ASSERT(cache.weights != nullptr);
