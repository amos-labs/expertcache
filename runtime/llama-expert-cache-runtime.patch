+// Async routed-union page prefetcher. Worker threads touch mapped expert
+// byte ranges so cold page-ins overlap GPU compute instead of serializing at
+// command-buffer schedule time. Read-only on a read-only file mapping: it can
+// change latency, never bytes.
+struct ggml_metal_expert_prefetcher {
+    struct prefetch_range {
+        const uint8_t * ptr;
+        size_t bytes;
+    };
+
+    struct tensor_entry {
+        const uint8_t * data;
+        size_t bytes_per_expert;
+        int64_t n_experts;
+        uint32_t build_counter = 0;
+        std::vector<uint32_t> last_seen; // build counter per expert, 0 = never
+    };
+
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::deque<prefetch_range> queue;
+    std::vector<std::thread> workers;
+    std::vector<tensor_entry> registry; // first-seen (graph) order
+    std::unordered_map<const void *, size_t> registry_index;
+    size_t page_size;
+    size_t max_queue;
+
+    explicit ggml_metal_expert_prefetcher(int n_threads) {
+        page_size = (size_t) sysconf(_SC_PAGESIZE);
+        max_queue = 4096;
+        for (int i = 0; i < n_threads; ++i) {
+            workers.emplace_back([this] { run(); });
+            workers.back().detach();
+        }
+    }
+
+    void run() {
+        for (;;) {
+            prefetch_range range;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                cv.wait(lock, [this] { return !queue.empty(); });
+                range = queue.front();
+                queue.pop_front();
+            }
+            touch(range);
+        }
+    }
+
+    void touch(const prefetch_range & range) {
+        const uintptr_t begin =
+            (uintptr_t) range.ptr & ~(uintptr_t) (page_size - 1);
+        const uintptr_t end = (uintptr_t) range.ptr + range.bytes;
+        madvise((void *) begin, end - begin, MADV_WILLNEED);
+        volatile uint8_t sink = 0;
+        for (uintptr_t page = begin; page < end; page += page_size) {
+            sink ^= *(const volatile uint8_t *) page;
+        }
+        (void) sink;
+    }
+
+    void enqueue(const uint8_t * ptr, size_t bytes) {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (queue.size() >= max_queue) {
+            return; // saturated: dropping a hint is always safe
+        }
+        queue.push_back({ ptr, bytes });
+        cv.notify_one();
+    }
+
+    // Record this tensor's routed experts, race the GPU on their pages, and
+    // prefetch the recent route union for the next `ahead` expert tensors
+    // (wrapping so the last layer warms layer 0 for the next token).
+    void on_routes(
+            const void * tensor_key,
+            const uint8_t * data,
+            size_t bytes_per_expert,
+            int64_t n_experts,
+            const std::vector<int32_t> & routed,
+            uint32_t window,
+            size_t ahead) {
+        size_t idx;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            auto it = registry_index.find(tensor_key);
+            if (it == registry_index.end()) {
+                idx = registry.size();
+                registry_index.emplace(tensor_key, idx);
+                registry.push_back(tensor_entry{});
+                tensor_entry & entry = registry.back();
+                entry.data = data;
+                entry.bytes_per_expert = bytes_per_expert;
+                entry.n_experts = n_experts;
+                entry.last_seen.assign((size_t) n_experts, 0);
+            } else {
+                idx = it->second;
+            }
+            tensor_entry & entry = registry[idx];
+            entry.build_counter++;
+            for (int32_t expert_id : routed) {
+                if (expert_id >= 0 && expert_id < entry.n_experts) {
+                    entry.last_seen[(size_t) expert_id] = entry.build_counter;
+                }
+            }
+        }
+
+        for (int32_t expert_id : routed) {
+            enqueue(data + (size_t) expert_id * bytes_per_expert,
+                    bytes_per_expert);
+        }
+
+        std::lock_guard<std::mutex> lock(mutex);
+        const size_t n_entries = registry.size();
+        if (n_entries < 2) {
+            return;
+        }
+        bool notified = false;
+        for (size_t k = 1; k <= ahead; ++k) {
+            const tensor_entry & next = registry[(idx + k) % n_entries];
+            const uint32_t floor =
+                next.build_counter > window ? next.build_counter - window : 1;
+            for (int64_t e = 0; e < next.n_experts; ++e) {
+                if (next.last_seen[(size_t) e] >= floor) {
+                    if (queue.size() >= max_queue) {
+                        break;
+                    }
+                    queue.push_back({
+                        next.data + (size_t) e * next.bytes_per_expert,
+                        next.bytes_per_expert });
+                    notified = true;
+                }
+            }
+        }
+        if (notified) {
+            cv.notify_all();
+        }
+    }
+};
