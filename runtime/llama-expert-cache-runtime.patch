+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv_id_gathered(ggml_metal_library_t lib, const ggml_tensor * op) {
+    const ggml_type tsrc0 = op->src[0]->type;
+    const ggml_type tsrc1 = op->src[1]->type;
+
+    // The ExpertCache grouped path only instantiates the MXFP4 dispatch; the
+    // candidacy check enforces the same constraint before selecting it.
+    GGML_ASSERT(tsrc0 == GGML_TYPE_MXFP4);
+    GGML_ASSERT(tsrc1 == GGML_TYPE_F32);
+
+    const int nsg = N_SG_MXFP4;
+    const int nr0 = N_R0_MXFP4;
+    const int nr1 = 1;
+    const size_t smem = 32*sizeof(float);
+
+    char base[256];
+    char name[256];
+
+    snprintf(base, 256, "kernel_mul_mv_id_gathered_%s_%s", ggml_type_name(tsrc0), ggml_type_name(tsrc1));
+    snprintf(name, 256, "%s_nsg=%d", base, nsg);
+
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        ggml_metal_cv_t cv = ggml_metal_cv_init();
+
+        ggml_metal_cv_set_int16(cv, nsg, FC_MUL_MV + 0);
+        ggml_metal_cv_set_int16(cv, 1,   FC_MUL_MV + 2);
+        ggml_metal_cv_set_int16(cv, 1,   FC_MUL_MV + 3);
+        ggml_metal_cv_set_int16(cv, 1,   FC_MUL_MV + 4);
+
+        res = ggml_metal_library_compile_pipeline(lib, base, name, cv);
+
+        ggml_metal_cv_free(cv);
+    }
+
+    res.nr0  = nr0;
+    res.nr1  = nr1;
+    res.nsg  = nsg;
+    res.smem = smem;
+
+    return res;
+}
